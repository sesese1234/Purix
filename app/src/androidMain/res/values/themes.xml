<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A bare splash theme only. Everything visible is drawn by Compose, so this
      exists purely to give the window the right background before first frame.
    -->
    <style name="Theme.Yomi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/yomi_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
